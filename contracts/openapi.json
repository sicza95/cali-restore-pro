    "/api/v1/status": {
      "get": {
        "operationId": "platformStatus",
        "summary": "Public readiness; exposes no account or database details",
        "responses": {
          "200": {
            "description": "Database and schema ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformStatus"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable or incompatible",
