  "components": {
    "schemas": {
      "PlatformStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "milestone"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "unavailable"]
          },
          "milestone": {
            "type": "string",
            "const": "M-00"
          }
        }
      },
      "IdentityError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_credentials",
              "authentication_required",
              "not_permitted",
              "credential_confirmation_required",
              "identity_conflict",
              "try_later",
              "unavailable",
              "json_required",
              "invalid_request"
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "description": "At least 15 Unicode characters; maximum 1024 UTF-8 bytes. No normalization."
          }
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["password"],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "CSRFResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["csrfToken"],
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "IdentityAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "state", "role"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "state": {
            "type": "string",
            "enum": ["pending_verification", "active", "suspended", "pending_deletion"]
          },
          "role": {
            "type": "string",
            "enum": ["member", "administrator", "superuser"]
          }
        }
      },
      "CurrentIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "capabilities", "csrfToken"],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/IdentityAccount"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "account.security",
                "accounts.suspend",
                "accounts.sessions.revoke",
                "roles.manage"
              ]
            }
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "createdAt", "current"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "SessionsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionInfo"
            }
          }
        }
      },
      "EmptyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "OKResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "RevokeSessionsRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionId", "confirm"],
            "properties": {
              "sessionId": {
                "type": "string",
                "format": "uuid"
              },
              "confirm": {
                "type": "boolean",
                "const": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["all", "confirm"],
            "properties": {
              "all": {
                "type": "boolean",
                "const": true
              },
              "confirm": {
                "type": "boolean",
                "const": true
              }
            }
          }
        ]
      },
      "PolicyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "state", "confirm"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["member", "administrator", "superuser"]
          },
          "state": {
            "type": "string",
            "enum": ["active", "suspended"]
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "ConfirmAction": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confirm"],
        "properties": {
          "confirm": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-calirestore_session",
        "description": "Production Secure HttpOnly SameSite=Strict host cookie. Development HTTP uses calirestore_session."
      }
    }
  }
}
