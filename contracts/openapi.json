                "schema": {
                  "$ref": "#/components/schemas/PlatformStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "identityLogin",
        "summary": "Verify credentials and issue a new opaque session",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must exactly match configured APP_ORIGIN."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CSRFResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or credentials rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "403": {
            "description": "Policy, recent confirmation, Origin or CSRF rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "409": {
            "description": "Account or session safeguard conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "429": {
            "description": "Shared rate or hashing concurrency limit; Retry-After: 900",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
